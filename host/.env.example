# ExtendedGram's public server. Keep this address unchanged.
COORDINATOR_URL=https://62.83.121.11

# OpenAI-compatible model server. For Docker Desktop on Windows, a model
# running directly on your PC is available through host.docker.internal.
OPEN_AI_URL=http://127.0.0.1:1234/v1

# Use the real key if the model server requires authentication.
OPENAI_API_KEY=local
COMPLETIONS_MODEL=your-completions-model
EMBEDDING_MODEL=your-embedding-model

# Optional: advertise several installed 1024-dimensional embedding models.
# When set, this list takes precedence over EMBEDDING_MODEL.
# EMBEDDING_MODELS=model-a,model-b
